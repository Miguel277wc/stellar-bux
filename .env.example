# Par pk_/sk_ do painel Axxon Pay: Integrações → Credenciais da API.
# O login usa esses dois campos. O PIX sai em Pagamentos Diretos.
AXXONPAY_API_KEY=
AXXONPAY_API_SECRET=

# CPF ou CNPJ enviado na cobrança quando o cliente não informa documento.
AXXONPAY_CUSTOMER_DOCUMENT=
AXXONPAY_CUSTOMER_NAME=

# Opcional. Sem isso o webhook do pedido não é cadastrado na criação.
AXXONPAY_POSTBACK_URL=
AXXONPAY_WEBHOOK_SECRET=
